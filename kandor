#!/usr/bin/env bash
#
# kandor - run OpenCode inside a bubblewrap sandbox.
#
# The sandbox is intentionally conservative:
#   * the host filesystem is mounted read-only at /
#   * your home directory is replaced by an empty tmpfs
#   * only the project, OpenCode's own state directories, and explicitly
#     requested paths are writable
#   * /tmp, /var/tmp, /run, /run/user/$UID, /mnt, /media and /srv are private
#   * the process gets its own PID/IPC/UTS/user/cgroup namespaces
#   * nested user namespaces are disabled when the kernel allows it
#
# OpenCode is run with --standalone whenever the command supports it, so it
# cannot connect to a background OpenCode service running outside the
# sandbox.  The host's service credentials are never mounted; isolated
# profiles write their own service.json with a private port, and --shared
# uses temporary config/state/cache copies.
#
# Requires: Linux, bubblewrap >= 0.5 (0.9+ recommended), Bash 4.3+.
#
set -euo pipefail

readonly PROG="${0##*/}"
readonly VERSION="0.1.0"
readonly SANDBOX_HOSTNAME="kandor"

log()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
die()  { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Run OpenCode inside a bubblewrap sandbox.

Usage:
  kandor [options] [--] [opencode arguments...]

The current directory (or --dir) is the only project directory mounted
read-write.  Your home directory is hidden.  By default OpenCode runs with
a sandbox-only profile under ~/.local/share/kandor/<profile>; the host
OpenCode config is copied in once so plugins and settings keep working.
Use --shared to share the host's session database instead (less isolated:
host session history becomes readable inside the sandbox; config, state and
cache use temporary copies).

Options:
  -C, --dir DIR           Project directory (default: current directory)
      --ro PATH           Mount PATH read-only (repeatable)
      --rw PATH           Mount PATH read-write (repeatable)
      --env NAME[=VALUE]  Pass an environment variable into the sandbox
                          (repeatable).  Without =VALUE, the host value is used.
      --isolated          Use a sandbox-only OpenCode profile (default)
      --shared            Share the host's OpenCode session database; config,
                          state and cache use a temporary copy
      --profile NAME      Profile name for the isolated profile (default: "default")
      --no-seed           Do not copy the host OpenCode config into a new
                          isolated profile
      --net               Share the host network (default; needed for LLM APIs)
      --no-net            Run without network access (--unshare-net)
      --ssh               Mount ~/.ssh read-only
      --ssh-agent         Forward $SSH_AUTH_SOCK into the sandbox
      --git-credentials   Mount ~/.git-credentials read-only
      --netrc             Mount ~/.netrc read-only
      --npmrc             Mount ~/.npmrc read-only
      --no-gitconfig      Do not mount ~/.gitconfig or ~/.config/git
      --allow-userns      Allow nested user namespaces (needed by browsers;
                          weakens the sandbox)
      --new-session       Detach from the controlling terminal (TIOCSTI
                          protection; may prevent TUI resize).  Default: on
                          only when the kernel permits TIOCSTI.
      --no-new-session    Keep the controlling terminal (enables TUI resize)
      --shell             Run a shell inside the sandbox instead of OpenCode
      --dry-run           Print the bwrap command and exit (environment
                          secrets are redacted; arguments are printed as-is)
      --verbose           Print sandbox details
  -h, --help              Show this help
  -V, --version           Show the wrapper version

Everything after "--" is passed to OpenCode verbatim.  Unknown options are
also passed to OpenCode, so these are equivalent:
  kandor --continue
  kandor -- --continue

Examples:
  kandor
  kandor -C ~/code/my-project
  kandor run "fix the failing tests"
  kandor auth login            # log in once per isolated profile
  kandor --shared              # use the host's OpenCode sessions
  kandor --no-net --shell
  kandor --ro ~/.config/gcloud --rw ~/go -- run "build it"
  kandor --dry-run

Configuration file:
  $XDG_CONFIG_HOME/kandor/config (default ~/.config/kandor/config)
  One directive per line:
      ro PATH
      rw PATH
      env NAME=VALUE
      net
      no-net
      isolated
      shared
      no-seed
      profile NAME
      ssh
      ssh-agent
      git-credentials
      netrc
      npmrc
      no-gitconfig
      allow-userns
      new-session
      no-new-session
  Lines beginning with # are ignored.  Command-line options are applied
  after the file and take precedence.
EOF
}

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

project_dir=$PWD
isolated=1
seed_config=1
profile=default
shared_tmp=
network=1
allow_userns=0
new_session=0
new_session_explicit=0
# TIOCSTI lets a process inject keystrokes into the controlling terminal.
# Modern kernels disable it; if it is enabled, prefer the safer default and
# tell the user how to get terminal resizing back.
if [[ ! -r /proc/sys/dev/tty/legacy_tiocsti ]] ||
   [[ $(< /proc/sys/dev/tty/legacy_tiocsti) != 0 ]]; then
  new_session=1
fi
allow_ssh=0
allow_ssh_agent=0
allow_gitconfig=1
allow_git_credentials=0
allow_netrc=0
allow_npmrc=0
shell_mode=0
dry_run=0
verbose=0
extra_ro=()
extra_rw=()
extra_env=()
oc_args=()

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

resolve_path() {
  local p=$1
  if realpath -e -- "$p" 2>/dev/null; then
    return 0
  fi
  readlink -f -- "$p" 2>/dev/null
}

resolve_path_maybe() {
  local p=$1
  if realpath -m -- "$p" 2>/dev/null; then
    return 0
  fi
  case $p in
    /*) printf '%s\n' "$p" ;;
    *)  printf '%s/%s\n' "$PWD" "$p" ;;
  esac
}

expand_path() {
  local p=$1
  case $p in
    "~")    p=$HOME ;;
    "~/"*)  p=$HOME/${p#\~/} ;;
    "\$HOME") p=$HOME ;;
    "\$HOME/"*) p=$HOME/${p#\$HOME/} ;;
  esac
  printf '%s\n' "$p"
}

# bwrap inherits open file descriptors.  Close everything except stdio and
# the shell's script descriptor (normally 255) so host pipes, sockets and
# files do not leak into the sandbox.
close_extra_fds() {
  local path fd
  if [[ -d /proc/$$/fd ]]; then
    for path in /proc/$$/fd/*; do
      fd=${path##*/}
      [[ $fd =~ ^[0-9]+$ ]] || continue
      case $fd in 0|1|2|255) continue ;; esac
      eval "exec $fd>&-" 2>/dev/null || true
    done
  else
    for ((fd = 3; fd < 255; fd++)); do
      eval "exec $fd>&-" 2>/dev/null || true
    done
  fi
}

# Find a TCP port that is currently free on the host.  OpenCode may start a
# private background service even for commands that do not accept
# --standalone; giving it a non-default port avoids colliding with the host's
# own service on 127.0.0.1.
find_free_port() {
  local port

  if command -v python3 >/dev/null 2>&1; then
    port=$(python3 - <<'PY' 2>/dev/null || true
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
)
    if [[ -n $port ]]; then
      printf '%s\n' "$port"
      return 0
    fi
  fi

  for ((port = 41000 + ($$ % 2000); port < 43000; port++)); do
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      printf '%s\n' "$port"
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# Configuration file
# ---------------------------------------------------------------------------

load_config() {
  local file=$1
  local line key rest

  [[ -f $file ]] || return 0

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    # Strip a comment that starts at the beginning of the line or after
    # whitespace.  A '#' in the middle of a path is preserved.
    [[ $line =~ ^[[:space:]]*# ]] && continue
    line=${line%%[[:space:]]#*}
    [[ $line =~ ^[[:space:]]*$ ]] && continue

    read -r key rest <<< "$line"
    case $key in
      ro)               extra_ro+=("$(expand_path "$rest")") ;;
      rw)               extra_rw+=("$(expand_path "$rest")") ;;
      env)              extra_env+=("$rest") ;;
      net)              network=1 ;;
      no-net)           network=0 ;;
      isolated)         isolated=1 ;;
      shared)           isolated=0 ;;
      no-seed)          seed_config=0 ;;
      profile)          profile=$rest; isolated=1 ;;
      ssh)              allow_ssh=1 ;;
      ssh-agent)        allow_ssh_agent=1 ;;
      git-credentials)  allow_git_credentials=1 ;;
      netrc)            allow_netrc=1 ;;
      npmrc)            allow_npmrc=1 ;;
      no-gitconfig)     allow_gitconfig=0 ;;
      allow-userns)     allow_userns=1 ;;
      new-session)      new_session=1; new_session_explicit=1 ;;
      no-new-session)   new_session=0; new_session_explicit=1 ;;
      '')               ;;
      *)                warn "ignoring unknown directive '$key' in $file" ;;
    esac
  done < "$file"
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

# Load the configuration file before command-line parsing so that command
# line options can override it.
if [[ -n ${HOME:-} ]]; then
  default_config=${XDG_CONFIG_HOME:-$HOME/.config}/kandor/config
else
  default_config=/nonexistent
fi
load_config "${KANDOR_CONFIG:-$default_config}"

while (($#)); do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    -V|--version)
      printf '%s %s\n' "$PROG" "$VERSION"
      exit 0
      ;;
    -C|--dir|--project)
      (($# >= 2)) || die "$1 requires a directory argument"
      project_dir=$2
      shift 2
      ;;
    --ro)
      (($# >= 2)) || die "--ro requires a path"
      extra_ro+=("$(expand_path "$2")")
      shift 2
      ;;
    --rw)
      (($# >= 2)) || die "--rw requires a path"
      extra_rw+=("$(expand_path "$2")")
      shift 2
      ;;
    --env)
      (($# >= 2)) || die "--env requires NAME or NAME=VALUE"
      extra_env+=("$2")
      shift 2
      ;;
    --isolated)
      isolated=1
      shift
      ;;
    --shared)
      isolated=0
      shift
      ;;
    --no-seed)
      seed_config=0
      shift
      ;;
    --profile)
      (($# >= 2)) || die "--profile requires a name"
      profile=$2
      isolated=1
      shift 2
      ;;
    --net)
      network=1
      shift
      ;;
    --no-net)
      network=0
      shift
      ;;
    --ssh)
      allow_ssh=1
      shift
      ;;
    --ssh-agent)
      allow_ssh_agent=1
      shift
      ;;
    --git-credentials)
      allow_git_credentials=1
      shift
      ;;
    --netrc)
      allow_netrc=1
      shift
      ;;
    --npmrc)
      allow_npmrc=1
      shift
      ;;
    --no-gitconfig)
      allow_gitconfig=0
      shift
      ;;
    --allow-userns)
      allow_userns=1
      shift
      ;;
    --new-session)
      new_session=1
      new_session_explicit=1
      shift
      ;;
    --no-new-session)
      new_session=0
      new_session_explicit=1
      shift
      ;;
    --shell)
      shell_mode=1
      shift
      ;;
    --dry-run|--print-command)
      dry_run=1
      shift
      ;;
    --verbose)
      verbose=1
      shift
      ;;
    --)
      shift
      oc_args+=("$@")
      break
      ;;
    -*)
      # Not one of our options: hand it (and everything after it) to
      # OpenCode.  This keeps top-level flags such as --continue working.
      oc_args+=("$@")
      break
      ;;
    *)
      # OpenCode's top-level positional argument is a directory.  Treat an
      # existing directory as the project, unless it is a subcommand name.
      case $1 in
        run|auth|mcp|plugin|debug|session|api|serve|acp|mini|models|stats|\
        pair|reload|service|upgrade|update|uninstall|completions)
          oc_args+=("$@")
          break
          ;;
      esac
      if [[ -d $1 ]]; then
        project_dir=$1
        shift
        continue
      fi
      oc_args+=("$@")
      break
      ;;
  esac
done

# --standalone is a per-command flag in OpenCode, not a global flag before a
# subcommand.  Drop a leading one and re-insert it in the right place below.
if [[ ${oc_args[0]:-} == --standalone ]]; then
  oc_args=("${oc_args[@]:1}")
fi

# ---------------------------------------------------------------------------
# Validation and paths
# ---------------------------------------------------------------------------

[[ -n ${HOME:-} ]] || die "HOME is not set"
[[ -d ${HOME:-} ]] || die "HOME is not a directory: $HOME"
HOME=$(resolve_path "$HOME") || die "cannot resolve HOME: $HOME"
[[ $HOME != / ]] || die "refusing to run with HOME=/"

[[ $profile =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
  die "invalid profile name '$profile' (use letters, digits, '.', '_' and '-')"

project_dir=$(resolve_path "$project_dir") ||
  die "project directory does not exist: $project_dir"
[[ -d $project_dir ]] || die "not a directory: $project_dir"
[[ $project_dir != / ]] || die "refusing to use / as the project directory"
[[ $project_dir != "$HOME" ]] ||
  die "refusing to use HOME as the project directory; run from a project subdirectory"
[[ $HOME != "$project_dir"/* ]] ||
  die "the project directory may not be an ancestor of HOME"

command -v bwrap >/dev/null 2>&1 ||
  die "bubblewrap (bwrap) is not installed"

BWRAP_HELP=$(bwrap --help 2>&1 || true)
[[ -n $BWRAP_HELP ]] || die "bwrap does not appear to work"

have_bwrap_opt() {
  grep -q -- "$1" <<< "$BWRAP_HELP"
}

# A quick preflight so the user gets a useful error instead of a cryptic
# bwrap failure after all the mounts have been prepared.
if have_bwrap_opt --unshare-user-try; then
  probe_userns=(--unshare-user-try)
else
  probe_userns=(--unshare-user)
fi
if ! bwrap --ro-bind / / "${probe_userns[@]}" -- /bin/true >/dev/null 2>&1; then
  cat >&2 <<EOF
$PROG: error: bubblewrap cannot create a user namespace.

This is usually one of:
  * unprivileged user namespaces are disabled
      sudo sysctl -w kernel.unprivileged_userns_clone=1
  * AppArmor restricts unprivileged user namespaces (Ubuntu 23.10+)
      see /etc/apparmor.d/unprivileged_userns
  * bwrap is running inside a container that blocks namespace creation
  * bwrap needs to be installed setuid root (check your distribution's
    bubblewrap package)

Run 'bwrap --ro-bind / / --unshare-user-try -- /bin/true' to reproduce.
EOF
  exit 1
fi

if (( shell_mode )); then
  shell_bin=${SHELL:-/bin/bash}
  [[ -x $shell_bin ]] || shell_bin=/bin/bash
  [[ -x $shell_bin ]] || die "no usable shell found (tried \$SHELL and /bin/bash)"
  shell_bin=$(resolve_path "$shell_bin") || shell_bin=/bin/bash
  oc_bin=
else
  oc_bin=${KANDOR_BIN:-}
  if [[ -z $oc_bin ]]; then
    oc_bin=$(type -P opencode || true)
  fi
  [[ -n $oc_bin ]] ||
    die "opencode was not found in PATH (set KANDOR_BIN to override)"
  oc_bin=$(resolve_path "$oc_bin") || die "cannot resolve the opencode binary"
  [[ -x $oc_bin ]] || die "opencode is not executable: $oc_bin"
fi

xdg_config=$(resolve_path_maybe "${XDG_CONFIG_HOME:-$HOME/.config}")
xdg_data=$(resolve_path_maybe "${XDG_DATA_HOME:-$HOME/.local/share}")
xdg_state=$(resolve_path_maybe "${XDG_STATE_HOME:-$HOME/.local/state}")
xdg_cache=$(resolve_path_maybe "${XDG_CACHE_HOME:-$HOME/.cache}")

if (( isolated )); then
  sandbox_home=$(resolve_path_maybe "${KANDOR_HOME:-$xdg_data/kandor}")
  profile_root=$sandbox_home/$profile
  sandbox_xdg_config=$profile_root/config
  sandbox_xdg_data=$profile_root/data
  sandbox_xdg_state=$profile_root/state
  sandbox_xdg_cache=$profile_root/cache
  mkdir -p -- "$sandbox_xdg_config" "$sandbox_xdg_data" \
              "$sandbox_xdg_state" "$sandbox_xdg_cache" ||
    die "cannot create the isolated profile at $profile_root"
  chmod 700 -- "$profile_root" 2>/dev/null || true
else
  # --shared shares the host session database but uses private copies of
  # config, state and cache.  This keeps the host service password and the
  # host's service registration out of the sandbox while still allowing
  # OpenCode to write its own service.json.
  # Remove stale copies from runs that were killed before their EXIT trap,
  # but leave directories whose owning process is still alive.
  while IFS= read -r -d '' stale; do
    stale_pid=$(cat "$stale/pid" 2>/dev/null || true)
    if [[ -n $stale_pid ]] && kill -0 "$stale_pid" 2>/dev/null; then
      continue
    fi
    rm -rf -- "$stale" 2>/dev/null || true
  done < <(find "${TMPDIR:-/tmp}" -maxdepth 1 -type d \
             -name "kandor-shared-$(id -u).*" -mmin +60 -print0 2>/dev/null)

  shared_tmp=$(mktemp -d "${TMPDIR:-/tmp}/kandor-shared-$(id -u).XXXXXX") ||
    die "cannot create a temporary shared profile"
  printf '%s\n' "$$" > "$shared_tmp/pid"
  trap 'rm -rf -- "$shared_tmp"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  sandbox_xdg_config=$shared_tmp/config
  sandbox_xdg_state=$shared_tmp/state
  sandbox_xdg_cache=$shared_tmp/cache
  sandbox_xdg_data=$xdg_data
  mkdir -p -- "$sandbox_xdg_config/opencode" "$sandbox_xdg_state/opencode" \
              "$sandbox_xdg_cache/opencode" ||
    die "cannot create the temporary shared profile"
  shopt -s nullglob
  for f in "$xdg_config/opencode"/*; do
    base=${f##*/}
    [[ $base == service.json ]] && continue
    cp -aL -- "$f" "$sandbox_xdg_config/opencode/" 2>/dev/null ||
      warn "could not copy $f into the shared sandbox profile"
  done
  shopt -u nullglob
fi

config_dir=$sandbox_xdg_config/opencode
data_dir=$sandbox_xdg_data/opencode
state_dir=$sandbox_xdg_state/opencode
cache_dir=$sandbox_xdg_cache/opencode

mkdir -p -- "$config_dir" "$data_dir" "$state_dir" "$cache_dir" ||
  die "cannot create OpenCode's config/data/state/cache directories"

if (( isolated && seed_config )); then
  # Copy the host config into a brand-new profile once.  This keeps plugins
  # and settings working without exposing the host's session database.
  if [[ ! -e $config_dir/.kandor-seeded ]]; then
    shopt -s nullglob
    for f in "$xdg_config/opencode"/*; do
      base=${f##*/}
      [[ $base == service.json ]] && continue
      cp -aL -- "$f" "$config_dir/" 2>/dev/null ||
        warn "could not copy $f into the sandbox profile"
    done
    shopt -u nullglob
    : > "$config_dir/.kandor-seeded" 2>/dev/null || true
  fi
elif (( ! isolated )); then
  warn "--shared shares the host OpenCode session database; config, state and cache use temporary copies"
fi

if (( new_session && ! new_session_explicit )); then
  warn "TIOCSTI is enabled on this kernel; using --new-session for safety"
  warn "terminal resizing may not work; pass --no-new-session to disable it"
fi

uid=$(id -u)
service_port=$(find_free_port 2>/dev/null || true)
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$uid}
runtime_dir=$(resolve_path_maybe "$runtime_dir")
if [[ ! -d $runtime_dir ]]; then
  runtime_dir=/tmp/kandor-runtime
fi

# ---------------------------------------------------------------------------
# Build the bubblewrap command
# ---------------------------------------------------------------------------

BWRAP=(bwrap)
BWRAP+=(--ro-bind / /)
BWRAP+=(--dev /dev)
BWRAP+=(--proc /proc)

declare -A mounted=()

add_mount() {
  local kind=$1 src=$2 dest=${3:-$2}
  [[ -n ${mounted[$dest]:-} ]] && return 0
  mounted[$dest]=1
  BWRAP+=("$kind" "$src" "$dest")
}

add_ro() { add_mount --ro-bind "$1" "${2:-$1}"; }
add_rw() { add_mount --bind "$1" "${2:-$1}"; }

add_tmpfs() {
  local dest=$1 mode=${2:-}
  [[ -e $dest ]] || return 0
  BWRAP+=(--tmpfs "$dest")
  if [[ -n $mode ]] && have_bwrap_opt --chmod; then
    BWRAP+=(--chmod "$mode" "$dest")
  fi
}

add_private_dir() {
  local dest=$1 mode=${2:-}
  BWRAP+=(--dir "$dest")
  BWRAP+=(--tmpfs "$dest")
  if [[ -n $mode ]] && have_bwrap_opt --chmod; then
    BWRAP+=(--chmod "$mode" "$dest")
  fi
}

# A read-only directory mount keeps symlinks, but their targets may live
# outside the mounted directory and would otherwise be invisible.  Mount the
# resolved targets at their own paths as well.
add_ro_symlink_targets() {
  local dir=$1 link target
  [[ -d $dir ]] || return 0
  while IFS= read -r -d '' link; do
    target=$(resolve_path "$link" 2>/dev/null || true)
    [[ -n $target && -e $target ]] || continue
    # Do not follow a symlink to a broad host path: it could expose the host
    # home or stack a read-only mount over the sandbox.
    if [[ $target == / || $target == "$HOME" || $HOME == "$target"/* ||
          $target == "$runtime_dir" || $target == /run/user ||
          $target == "/run/user/$uid" || $target =~ ^/[^/]+$ ]]; then
      warn "not following symlink to broad host path: $link -> $target"
      continue
    fi
    # Mount the target at its own path so the symlink can resolve.  bwrap
    # refuses to mount directly on a symlink destination.
    add_ro "$target"
  done < <(find -P "$dir" -type l -print0 2>/dev/null)
}

# Hide the home directory.  bwrap resolves mount sources before applying
# mounts, so binding paths below HOME after this still works.
home_parent=
case $HOME in
  /home/*)    home_parent=/home ;;
  /root)      home_parent=/root ;;
  /tmp/*)     home_parent=/tmp ;;
  /var/tmp/*) home_parent=/var/tmp ;;
  /mnt/*)     home_parent=/mnt ;;
  /media/*)   home_parent=/media ;;
  /srv/*)     home_parent=/srv ;;
  *)          home_parent=$HOME ;;
esac
case $home_parent in
  /tmp|/var/tmp) add_tmpfs "$home_parent" 1777 ;;
  *)             add_tmpfs "$home_parent" ;;
esac
BWRAP+=(--dir "$HOME")

# Private scratch space.  Do not hide a directory that contains HOME.
hide_scratch() {
  local dest=$1 mode=${2:-}
  [[ $HOME == "$dest" || $HOME == "$dest"/* ]] && return 0
  add_tmpfs "$dest" "$mode"
}
hide_scratch /root
hide_scratch /tmp 1777
hide_scratch /var/tmp 1777
hide_scratch /mnt
hide_scratch /media
hide_scratch /srv

# Hide host runtime sockets (system DBus, journal, keyrings, systemd user
# services, ...) but keep the resolver configuration that /etc/resolv.conf
# points at, otherwise DNS stops working on systemd-resolved systems.
add_tmpfs /run
# In the unusual case that HOME lives under /run, recreate it after the
# tmpfs mount.  Harmless otherwise.
BWRAP+=(--dir "$HOME")
resolv_target=$(resolve_path /etc/resolv.conf 2>/dev/null || true)
case $resolv_target in
  /run/*)
    # Recreate only the resolver file, not the rest of /run/systemd (which
    # contains journal, varlink and other host sockets).
    add_private_dir "$(dirname "$resolv_target")"
    add_ro "$resolv_target"
    ;;
esac

# A private runtime directory (DBus, keyrings and SSH agent sockets from the
# host are not visible there unless explicitly requested below).
add_private_dir "$runtime_dir" 0700

# The project itself.
add_rw "$project_dir"

# A worktree's .git file points at a per-worktree directory inside the main
# repository's .git directory.  Verify that back-reference before exposing
# the common directory: an untrusted project must not be able to point its
# .git file at an arbitrary host directory.
is_valid_worktree_common() {
  local common=$1 git_file=$project_dir/.git
  local line per_wt back

  [[ -f $git_file ]] || return 1
  IFS= read -r line < "$git_file" || return 1
  line=${line%$'\r'}
  [[ $line == gitdir:* ]] || return 1

  per_wt=${line#gitdir:}
  per_wt=${per_wt#"${per_wt%%[![:space:]]*}"}
  per_wt=${per_wt%"${per_wt##*[![:space:]]}"}
  [[ $per_wt == /* ]] || per_wt=$project_dir/$per_wt
  per_wt=$(resolve_path "$per_wt" 2>/dev/null) || return 1
  [[ $per_wt == "$common"/* ]] || return 1

  [[ -f $per_wt/gitdir ]] || return 1
  IFS= read -r back < "$per_wt/gitdir" || return 1
  back=${back%$'\r'}
  [[ $back == /* ]] || back=$project_dir/$back
  back=$(resolve_path "$back" 2>/dev/null) || return 1
  [[ $back == "$(resolve_path "$git_file")" ]] || return 1
  return 0
}

git_common_allowed() {
  local common=$1 ancestor=$project_dir

  case $common in
    "$project_dir"|"$project_dir"/*) return 0 ;;
  esac

  # Submodules keep their git directory inside an ancestor repository's
  # .git/modules directory.
  while [[ $ancestor != / && $ancestor != . ]]; do
    ancestor=$(dirname "$ancestor")
    case $common in
      "$ancestor"/.git|"$ancestor"/.git/*) return 0 ;;
    esac
  done

  is_valid_worktree_common "$common"
}

git_probe() {
  ( unset GIT_DIR GIT_WORK_TREE; git -C "$project_dir" "$@" )
}

if command -v git >/dev/null 2>&1 &&
   git_probe rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git_common=$(git_probe rev-parse --path-format=absolute \
                 --git-common-dir 2>/dev/null || true)
  if [[ -z $git_common ]]; then
    # Older Git versions do not support --path-format.
    git_common=$(git_probe rev-parse --git-common-dir 2>/dev/null || true)
    [[ -n $git_common && $git_common != /* ]] && git_common=$project_dir/$git_common
  fi
  if [[ -n $git_common && -e $git_common ]]; then
    git_common=$(resolve_path "$git_common") || git_common=
    case $git_common in
      ''|"$project_dir"|"$project_dir"/*) ;;
      *)
        if git_common_allowed "$git_common"; then
          add_rw "$git_common"
        else
          warn "refusing to mount an untrusted git directory outside the project: $git_common"
          warn "git operations may fail; use --rw '$git_common' if you trust this repository"
        fi
        ;;
    esac
  fi
fi

# OpenCode's persistent state.
add_rw "$config_dir"
add_rw "$data_dir"
add_rw "$state_dir"
add_rw "$cache_dir"
if (( ! isolated )) && [[ -d $xdg_cache/opencode/bin ]]; then
  # Reuse the host's cached ripgrep binary without exposing the host cache
  # (and its npm packages) read-write.
  add_ro "$xdg_cache/opencode/bin" "$cache_dir/bin"
  add_ro_symlink_targets "$xdg_cache/opencode/bin"
fi

# The OpenCode (or debug shell) binary and the runtime/user tool directories.
if (( shell_mode )); then
  add_ro "$(dirname "$shell_bin")"
else
  add_ro "$(dirname "$oc_bin")"
fi
[[ -d $HOME/.bun ]] && add_ro "$HOME/.bun"
for d in "$HOME/.local/bin" "$HOME/bin" "$HOME/.opencode/bin" \
         "$HOME/go/bin" "$HOME/.cargo/bin"; do
  if [[ -d $d ]]; then
    add_ro "$d"
    add_ro_symlink_targets "$d"
  fi
done

# Git configuration.  Without it, commits inside the sandbox have no author.
if (( allow_gitconfig )); then
  [[ -f $HOME/.gitconfig ]] && add_ro "$HOME/.gitconfig"
  [[ -f $HOME/.gitignore_global ]] && add_ro "$HOME/.gitignore_global"
  if [[ -n ${GIT_CONFIG_GLOBAL:-} && -e ${GIT_CONFIG_GLOBAL} ]]; then
    if p=$(resolve_path "$GIT_CONFIG_GLOBAL" 2>/dev/null); then
      add_ro "$p"
      # Prepend so an explicit --env GIT_CONFIG_GLOBAL on the command line
      # can still override it.
      extra_env=("GIT_CONFIG_GLOBAL=$p" "${extra_env[@]}")
    fi
  elif [[ -d $xdg_config/git ]]; then
    # Keep the host path: Git also follows symlinks inside this directory,
    # and those targets live at their original host paths.
    add_ro "$xdg_config/git"
    add_ro_symlink_targets "$xdg_config/git"
    if [[ -f $xdg_config/git/config ]]; then
      extra_env=("GIT_CONFIG_GLOBAL=$xdg_config/git/config" "${extra_env[@]}")
    fi
  fi
fi

# Opt-in credential mounts.
if (( allow_ssh )); then
  if [[ -d $HOME/.ssh ]]; then
    add_ro "$HOME/.ssh"
    add_ro_symlink_targets "$HOME/.ssh"
  else
    warn "--ssh was requested but $HOME/.ssh does not exist"
  fi
fi
if (( allow_ssh_agent )); then
  if [[ -n ${SSH_AUTH_SOCK:-} && -S ${SSH_AUTH_SOCK:-} ]] &&
     p=$(resolve_path "$SSH_AUTH_SOCK" 2>/dev/null); then
    add_ro "$p"
  else
    warn "--ssh-agent was requested but SSH_AUTH_SOCK is not a socket"
    allow_ssh_agent=0
  fi
fi
if (( allow_git_credentials )); then
  if [[ -f $HOME/.git-credentials ]]; then
    add_ro "$HOME/.git-credentials"
  else
    warn "--git-credentials was requested but $HOME/.git-credentials does not exist"
  fi
fi
if (( allow_netrc )); then
  if [[ -f $HOME/.netrc ]]; then
    add_ro "$HOME/.netrc"
  else
    warn "--netrc was requested but $HOME/.netrc does not exist"
  fi
fi
if (( allow_npmrc )); then
  if [[ -f $HOME/.npmrc ]]; then
    add_ro "$HOME/.npmrc"
  else
    warn "--npmrc was requested but $HOME/.npmrc does not exist"
  fi
fi

# Credential and CA files referenced by forwarded environment variables.
for var in GOOGLE_APPLICATION_CREDENTIALS NODE_EXTRA_CA_CERTS SSL_CERT_FILE \
           CURL_CA_BUNDLE REQUESTS_CA_BUNDLE AWS_SHARED_CREDENTIALS_FILE \
           AWS_CONFIG_FILE AWS_CA_BUNDLE GIT_SSL_CAINFO GIT_SSL_CAPATH; do
  val=${!var:-}
  [[ -n $val ]] || continue
  if [[ -e $val ]] && p=$(resolve_path "$val" 2>/dev/null); then
    add_ro "$p"
  else
    warn "$var points to a path that does not exist: $val"
  fi
done
if [[ -n ${SSL_CERT_DIR:-} && -d ${SSL_CERT_DIR} ]] &&
   p=$(resolve_path "$SSL_CERT_DIR" 2>/dev/null); then
  add_ro "$p"
fi

# Explicit extra mounts.
add_extra_mount() {
  local mode=$1 p=$2
  [[ -n $p ]] || return 0
  [[ -e $p ]] || die "$mode path does not exist: $p"
  p=$(resolve_path "$p") || die "$mode path cannot be resolved: $p"
  # Refuse the obvious ways to accidentally recreate the host inside the
  # sandbox.  Deliberate subdirectory and file mounts are still possible.
  if [[ $p == / || $p == "$HOME" || $HOME == "$p"/* ||
        $p == "$runtime_dir" || $p == /run/user || $p == "/run/user/$uid" ]]; then
    die "refusing to mount '$p'; mount a subdirectory or file instead"
  fi
  if [[ $p =~ ^/[^/]+$ ]]; then
    die "refusing to mount top-level directory '$p'; mount a subdirectory or file instead"
  fi
  # Do not deduplicate: a later mount of the same path (for example an --rw
  # on the command line after an ro directive in the config file) should win.
  if [[ $mode == ro ]]; then
    BWRAP+=(--ro-bind "$p" "$p")
  else
    BWRAP+=(--bind "$p" "$p")
  fi
}
for p in "${extra_ro[@]}"; do add_extra_mount ro "$p"; done
for p in "${extra_rw[@]}"; do add_extra_mount rw "$p"; done

# Service credentials.  Both profile modes use a writable, private config and
# state directory, so OpenCode can create and update its own service.json.
# A free port prevents a sandbox service from colliding with the host service.
if [[ -n $service_port ]]; then
  service_content=$(printf '{"port": %s}' "$service_port")
else
  service_content='{}'
  warn "could not find a free TCP port for OpenCode's private service"
fi

rm -f -- "$config_dir/service.json" "$state_dir/service.json" 2>/dev/null || true
if ! { printf '%s\n' "$service_content" > "$config_dir/service.json"; } 2>/dev/null; then
  warn "could not write $config_dir/service.json"
fi
if ! { printf '{}\n' > "$state_dir/service.json"; } 2>/dev/null; then
  warn "could not write $state_dir/service.json"
fi
chmod 600 "$config_dir/service.json" "$state_dir/service.json" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Namespaces and security options
# ---------------------------------------------------------------------------

if have_bwrap_opt --unshare-user-try; then
  userns_opt=(--unshare-user-try)
else
  userns_opt=(--unshare-user)
fi

if (( allow_userns )); then
  BWRAP+=("${userns_opt[@]}")
elif have_bwrap_opt --disable-userns &&
     bwrap --ro-bind / / --unshare-user --disable-userns -- /bin/true \
       >/dev/null 2>&1; then
  BWRAP+=(--unshare-user --disable-userns)
else
  BWRAP+=("${userns_opt[@]}")
  (( verbose )) && warn "nested user namespaces cannot be disabled on this system"
fi

BWRAP+=(--unshare-pid)
BWRAP+=(--unshare-ipc)
BWRAP+=(--unshare-uts)
have_bwrap_opt --unshare-cgroup-try && BWRAP+=(--unshare-cgroup-try)
(( network )) || BWRAP+=(--unshare-net)

BWRAP+=(--hostname "$SANDBOX_HOSTNAME")
if (( new_session )) && have_bwrap_opt --new-session; then
  BWRAP+=(--new-session)
fi
have_bwrap_opt --die-with-parent && BWRAP+=(--die-with-parent)
have_bwrap_opt --cap-drop && BWRAP+=(--cap-drop ALL)

BWRAP+=(--chdir "$project_dir")

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

BWRAP+=(--clearenv)
setenv() { BWRAP+=(--setenv "$1" "$2"); }

sandbox_path=${PATH:-/usr/local/bin:/usr/bin:/bin}
case ":$sandbox_path:" in
  *:/usr/bin:*) ;;
  *) sandbox_path=/usr/bin:/bin:$sandbox_path ;;
esac

setenv HOME "$HOME"
setenv USER "${USER:-$(id -un)}"
setenv LOGNAME "${LOGNAME:-${USER:-$(id -un)}}"
setenv SHELL "${SHELL:-/bin/bash}"
setenv PATH "$sandbox_path"
setenv HOSTNAME "$SANDBOX_HOSTNAME"
setenv TERM "${TERM:-xterm-256color}"
setenv TMPDIR /tmp
setenv XDG_CONFIG_HOME "$sandbox_xdg_config"
setenv XDG_DATA_HOME "$sandbox_xdg_data"
setenv XDG_STATE_HOME "$sandbox_xdg_state"
setenv XDG_CACHE_HOME "$sandbox_xdg_cache"
setenv XDG_RUNTIME_DIR "$runtime_dir"
setenv LANG "${LANG:-C.UTF-8}"
setenv OPENCODE_DISABLE_AUTOUPDATE 1

[[ -n ${COLORTERM:-} ]] && setenv COLORTERM "$COLORTERM"
[[ -n ${NO_COLOR:-} ]] && setenv NO_COLOR "$NO_COLOR"
[[ -n ${FORCE_COLOR:-} ]] && setenv FORCE_COLOR "$FORCE_COLOR"
[[ -n ${CLICOLOR:-} ]] && setenv CLICOLOR "$CLICOLOR"
[[ -n ${CLICOLOR_FORCE:-} ]] && setenv CLICOLOR_FORCE "$CLICOLOR_FORCE"
[[ -n ${TZ:-} ]] && setenv TZ "$TZ"
[[ -n ${EDITOR:-} ]] && setenv EDITOR "$EDITOR"
[[ -n ${VISUAL:-} ]] && setenv VISUAL "$VISUAL"
(( allow_ssh_agent )) && setenv SSH_AUTH_SOCK "$(resolve_path "$SSH_AUTH_SOCK")"

# Forward provider credentials, proxy settings and CA configuration.  The
# list is deliberately narrow: arbitrary host variables (and especially the
# host's OPENCODE_* service/session variables) are not inherited.
while IFS= read -r name; do
  [[ -n $name ]] || continue
  case $name in
    HOME|USER|LOGNAME|SHELL|PATH|TERM|COLORTERM|NO_COLOR|FORCE_COLOR|CLICOLOR|CLICOLOR_FORCE|\
    TMPDIR|TZ|LANG|LANGUAGE|LC_*|XDG_*|HOSTNAME|PWD|OLDPWD|SHLVL|_|\
    EDITOR|VISUAL)
      continue
      ;;
    OPENCODE|OPENCODE_SESSION_ID|OPENCODE_CLIENT|OPENCODE_TERMINAL|\
    OPENCODE_PASSWORD|OPENCODE_SERVER_PASSWORD|OPENCODE_DB|OPENCODE_CONFIG|\
    OPENCODE_CONFIG_DIR|OPENCODE_CONFIG_CONTENT|AI_AGENT|SSH_AUTH_SOCK|\
    DBUS_SESSION_BUS_ADDRESS|DISPLAY|WAYLAND_DISPLAY|XAUTHORITY)
      continue
      ;;
  esac
  case $name in
    *_API_KEY|*_API_KEY_*|*_API_BASE|*_API_BASE_*|*_BASE_URL|*_AUTH_TOKEN|\
    *_ACCESS_TOKEN|*_SECRET_KEY|*_SECRET_ACCESS_KEY|*_API_TOKEN|*_ACCESS_KEY|\
    *_SESSION_TOKEN)
      setenv "$name" "${!name}"
      ;;
    OPENAI_*|ANTHROPIC_*|OPENROUTER_*|GEMINI_*|GOOGLE_*|VERTEX_*|AWS_*|\
    AZURE_*|DEEPSEEK_*|XAI_*|GROQ_*|MISTRAL_*|COHERE_*|PERPLEXITY_*|\
    TOGETHER_*|FIREWORKS_*|CEREBRAS_*|OLLAMA_*|LMSTUDIO_*|LM_STUDIO_*|\
    HF_*|HUGGING_FACE_*|REPLICATE_*)
      setenv "$name" "${!name}"
      ;;
    HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy)
      setenv "$name" "${!name}"
      ;;
    SSL_CERT_FILE|SSL_CERT_DIR|NODE_EXTRA_CA_CERTS|CURL_CA_BUNDLE|\
    REQUESTS_CA_BUNDLE|GIT_SSL_CAINFO|GIT_SSL_CAPATH|AWS_CA_BUNDLE)
      setenv "$name" "${!name}"
      ;;
    EDITOR|VISUAL|GIT_EDITOR)
      setenv "$name" "${!name}"
      ;;
    LANG|LANGUAGE|LC_*|TZ)
      setenv "$name" "${!name}"
      ;;
    TERM_PROGRAM|TERM_PROGRAM_VERSION)
      setenv "$name" "${!name}"
      ;;
    *)
      continue
      ;;
  esac
done < <(compgen -e)

for spec in "${extra_env[@]}"; do
  [[ -n $spec ]] || continue
  if [[ $spec == *=* ]]; then
    name=${spec%%=*}
    value=${spec#*=}
  else
    name=$spec
    if [[ ! -v $name ]]; then
      warn "environment variable $name is not set; skipping"
      continue
    fi
    value=${!name}
  fi
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
    die "invalid environment variable name: $name"
  setenv "$name" "$value"
done

# ---------------------------------------------------------------------------
# OpenCode command line
# ---------------------------------------------------------------------------

if (( shell_mode )); then
  cmd=("$shell_bin" -l)
  ((${#oc_args[@]})) && cmd+=("${oc_args[@]}")
else
  # Refuse commands that would talk to the host's background service or
  # manage the host installation.
  first_arg=
  for arg in "${oc_args[@]}"; do
    [[ $arg == -* ]] && continue
    first_arg=$arg
    break
  done
  case $first_arg in
    service)
      die "refusing to run 'opencode service' inside the sandbox; use --standalone commands instead"
      ;;
    uninstall|upgrade|update)
      die "refusing to run 'opencode $first_arg' inside the sandbox"
      ;;
    pair)
      die "refusing to run 'opencode pair' inside the sandbox (it connects to the host service)"
      ;;
  esac
  for arg in "${oc_args[@]}"; do
    case $arg in
      --server|--server=*|--service)
        die "refusing '$arg' inside the sandbox; the sandbox always uses a private server"
        ;;
    esac
  done
  if [[ $first_arg == acp ]]; then
    for arg in "${oc_args[@]}"; do
      [[ $arg == --login ]] &&
        die "use 'kandor auth login' instead of 'acp --login' inside the sandbox"
    done
  fi

  has_standalone=0
  has_help=0
  has_version=0
  for arg in "${oc_args[@]}"; do
    # Options after "--" are positional arguments (for example a prompt that
    # happens to be named "--help"), not flags.
    [[ $arg == -- ]] && break
    case $arg in
      --standalone) has_standalone=1 ;;
      --help|-h)    has_help=1 ;;
      --version)    has_version=1 ;;
    esac
  done

  if ((${#oc_args[@]} == 0)); then
    cmd=("$oc_bin" --standalone)
  elif (( has_standalone )); then
    cmd=("$oc_bin" "${oc_args[@]}")
  elif (( has_help || has_version )); then
    cmd=("$oc_bin" "${oc_args[@]}")
  else
    sub=${oc_args[0]}
    case $sub in
      completions|debug|mcp|plugin|serve|acp)
        # These commands either do not use a server or start their own.
        cmd=("$oc_bin" "${oc_args[@]}")
        ;;
      auth|session)
        # Nested subcommand, e.g. "auth list" or "session export".
        path=("$sub")
        for ((i = 1; i < ${#oc_args[@]}; i++)); do
          arg=${oc_args[$i]}
          [[ $arg == -* ]] && continue
          path+=("$arg")
          break
        done
        if ((${#path[@]} > 1)); then
          cmd=("$oc_bin" "${path[@]}" --standalone \
               "${oc_args[@]:${#path[@]}}")
        else
          # Bare "auth" or "session" prints help; no server is involved.
          cmd=("$oc_bin" "${oc_args[@]}")
        fi
        ;;
      run|api|models|stats|mini|reload)
        # These commands accept --standalone and use a server.  Insert it
        # after the subcommand rather than relying on help-text formatting.
        cmd=("$oc_bin" "$sub" --standalone "${oc_args[@]:1}")
        ;;
      -*|*)
        # No subcommand: the TUI.  --standalone is a top-level flag here.
        cmd=("$oc_bin" --standalone "${oc_args[@]}")
        ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

if (( verbose )); then
  log "project:  $project_dir"
  if (( isolated )); then
    log "profile:  $profile ($profile_root)"
  else
    log "profile:  shared sessions (private config/state/cache copy)"
  fi
  log "network:  $([[ $network == 1 ]] && echo shared || echo isolated)"
  log "runtime:  $runtime_dir"
  (( shell_mode )) && log "command:  $shell_bin" || log "command:  $oc_bin"
fi

if (( dry_run )); then
  printable=("${BWRAP[@]}" -- "${cmd[@]}")
  for ((i = 0; i < ${#printable[@]}; i++)); do
    if [[ ${printable[$i]} == --setenv ]] && ((i + 2 < ${#printable[@]})); then
      name=${printable[$((i + 1))]}
      case $name in
        *KEY*|*TOKEN*|*SECRET*|*PASSWORD*|*CREDENTIAL*|AWS_*|AZURE_*|\
        GOOGLE_APPLICATION_CREDENTIALS|SSH_AUTH_SOCK)
          printable[$((i + 2))]='<redacted>'
          ;;
      esac
    fi
  done
  printf '%q ' "${printable[@]}"
  printf '\n'
  exit 0
fi

if [[ -n $shared_tmp ]]; then
  # Keep the shell alive so the temporary shared config/state copy can be
  # removed when bwrap exits.
  close_extra_fds
  "${BWRAP[@]}" -- "${cmd[@]}"
  status=$?
  rm -rf -- "$shared_tmp"
  trap - EXIT
  exit "$status"
fi

close_extra_fds
exec "${BWRAP[@]}" -- "${cmd[@]}"
